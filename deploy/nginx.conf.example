# janus nginx 反向代理配置（server 块，include 进 http{} 或 conf.d 均可）：
#
#   include /etc/nginx/conf.d/janus.conf;
#
# 要点（都是实测踩过的坑，别删）：
#   - SSE 流式回答必须 proxy_buffering off，否则客户端等到回合结束才一次性收到，
#     表现为"长时间无输出然后整段蹦出来"；
#   - agent 回合（含 30m 工具长等待）可能远超 nginx 默认 60s 读超时，
#     proxy_read_timeout 必须拉长，否则表现为"回答到一半连接被掐"；
#   - client_max_body_size 放开：对话历史/附件可到几十 MB（实测单请求 100KB+）。

upstream janus_backend {
    server 127.0.0.1:2810;
    keepalive 16;
}

server {
    listen 80;
    # listen 443 ssl;
    # ssl_certificate     /etc/nginx/ssl/janus.example.com.pem;
    # ssl_certificate_key /etc/nginx/ssl/janus.example.com.key;
    server_name janus.example.com;

    # 对话历史 + 附件（base64 后体积膨胀 ~1.33 倍）
    client_max_body_size 100m;
    client_body_timeout 300s;

    location / {
        proxy_pass http://janus_backend;
        proxy_http_version 1.1;

        # SSE / 流式：上游用长连接逐块推送
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;

        # agent 一轮可达数分钟（工具长等待 30m），读超时必须盖过最坏情况
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 10s;

        # 透传鉴权与客户端信息（janus 按 X-Forwarded-For / UA 记日志）
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 请求不落盘直接转发，附件上传更顺滑
        proxy_request_buffering off;
    }
}
