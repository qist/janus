[Unit]
Description=Janus - unified AI/agent gateway (OpenAI + Anthropic)
Documentation=https://github.com/qist/janus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 本机自用建议以 root 运行：janus 需要读 OpenCode 的凭据库
# （/root/.local/share/opencode，/root 是 700）、并可能读写项目目录。
# 用独立用户会在这些地方遇到大量权限问题（要用就自行授予对应目录的读写权限）。
User=root

# 配置文件与 janus.env.example 同格式（KEY=VALUE）
Environment=JANUS_CONFIG=/etc/janus/janus.env

# 持久化库固定路径（systemd 的 StateDirectory=janus 会确保 /var/lib/janus 存在）
Environment=BRIDGE_DB=/var/lib/janus/janus.db

ExecStart=/usr/local/bin/janus
Restart=on-failure
RestartSec=3

# 轻量加固（不做整盘只读，避免桥在项目目录/凭据库上写不进去）
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=janus
# SSE 长连接较多时放宽文件描述符
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
