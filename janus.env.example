# ============================================================================
# Janus 配置模板
#
# 用法：
#   1. 复制成 janus.env
#        cp janus.env.example janus.env
#   2. 按需修改（最少只需要改 BRIDGE_API_KEY）
#   3. 启动
#        ./scripts/run.sh        # 或 ./janus
#
# 规则：
#   - 只写 KEY=VALUE，一行一个；# 开头是注释
#   - 值可以不加引号；要写空格或 # 时用双引号包起来
#   - **真实环境变量优先级更高**，可临时覆盖：
#        BRIDGE_LOG_LEVEL=debug ./janus
#   - 换配置文件：JANUS_CONFIG=/path/to/other.env ./janus
#     （兼容旧名 BRIDGE_CONFIG）
# ============================================================================


# ----------------------------------------------------------------------------
# 服务监听
# ----------------------------------------------------------------------------

# bridge 监听地址。
#   0.0.0.0:2810  局域网可访问（务必设 BRIDGE_API_KEY）
#   127.0.0.1:2810 仅本机
BRIDGE_ADDR=127.0.0.1:2810

# 客户端鉴权。客户端填这个值当 API Key。
# 留空 = 接受任意 Key 并打 WARN（仅限本机调试，不要这样裸奔到公网）
BRIDGE_API_KEY=sk-change-me

# 允许的浏览器来源（CORS）。
#   留空（默认）= 不发任何 CORS 头 = 拒绝跨源浏览器访问
#   *            = 允许任意来源（不带 credentials）
#   a,b          = 白名单，命中才放行（带 credentials）
# 桌面客户端（Trae/CodeBuddy）不受 CORS 约束，留空即可。
# BRIDGE_CORS_ORIGIN=


# ----------------------------------------------------------------------------
# 上游 OpenCode
# ----------------------------------------------------------------------------

# 上游地址。
#   auto                = 自动发现 / 自动拉起（推荐）。OpenCode 桌面端每次重启都换
#                         随机端口和随机密码，写死撑不过一次重启。
#                         没找到在跑的 OpenCode 时，本桥会自己以随机端口拉一个；
#                         没装则提示安装（见 OPENCODE_AUTOSTART）。
#   http://host:port    = 固定地址（远程实例用这个，此时必须同时设密码；不会自动拉起）
OPENCODE_URL=auto

# 是否允许本桥自动拉起 OpenCode（仅 auto 模式生效）。默认 true。
# 关掉就只发现、不拉起。
# OPENCODE_AUTOSTART=true

# 是否复用已在跑的外部 OpenCode。默认 true（优先复用，没有才自己拉）。
# 设为 false 时 janus 总是自己拉起一个 —— 这样才能通过 OPENCODE_CONFIG_CONTENT
# 注入 janus 自动生成的 agent 配置（复用外部实例时注入不生效）。
# OPENCODE_REUSE_EXTERNAL=true

# 显式指定 opencode 可执行文件（可选）。空 = 自动查找 PATH / ~/.opencode/bin/opencode。
# OPENCODE_BIN=

# 上游 Basic 认证用户名，OpenCode 固定是 opencode，一般不用改
OPENCODE_USERNAME=opencode

# 上游密码。auto 模式下会自动从进程环境读取（本桥拉起的则用本桥生成的），留空即可。
# 只有 OPENCODE_URL 写死时才需要手填。
# 别名：OPENCODE_SERVER_PASSWORD（与 OPENCODE_PASSWORD 二选一）
# OPENCODE_PASSWORD=


# ----------------------------------------------------------------------------
# 会话
# ----------------------------------------------------------------------------

# 会话默认工作目录（OpenCode 的项目路径）。可选：
#   - 客户端请求会带 X-OpenCode-Directory，agent 工具也会传项目目录，通常无需配置
#   - 不配（注释掉）时用进程 cwd；systemd 下 cwd 是 /
# BRIDGE_DIRECTORY=/path/to/project

# 模型别名（default / auto / 空）解析成哪个模型。
#   留空 = 跟随上游当前默认模型，不写死
#   也可固定，例如：opencode-go/gpt-6-luna
# 注意：
#   - 客户端在请求里显式传的 model 字段**始终透传**，不受这里影响；
#     这里只决定"客户端没指定模型时用哪个"。
#   - 上游默认若是 `opencode/*` 免费模型，经 API 调用会被拒
#     （403 "free tier can only be used from within OpenCode"）。
#     所以要支持"不带 model"的请求，就显式填一个可用的（如 opencode-go/...）。
# 推荐：客户端固定传 model，这里可留空。
# BRIDGE_DEFAULT_MODEL=

# 模型别名映射（逗号分隔 from=to，键不区分大小写；键以 * 结尾表示前缀匹配）。
# 主要给 Claude Code 用：CC 只会用少数几个档位名（claude-opus* / claude-sonnet* / claude-haiku*），
# 所以**不需要逐个模型映射**，只映射这 3 个档位即可。
# 提示：不知道填什么模型时，运行 `janus models` —— 它会列出所有可用模型并给出当前档位映射。
# 例（DeepSeek 式：opus→强模型，sonnet/haiku→快模型）：
# BRIDGE_MODEL_MAP=claude-opus*=opencode-go/gpt-6-luna,claude-sonnet*=opencode-go/deepseek-v4.1-flash,claude-haiku*=opencode-go/glm-5.3-flash
# 更省事：只配 BRIDGE_DEFAULT_MODEL（上面那个），所有档位都会走它。

# 默认 agent。必须是 OpenCode 里真实存在的 agent id：
#   build        完整读写代码（默认，权限较宽）
#   plan         只读/规划，先规划再动手
#   general      通用 agent（偏子任务）
#   explore      搜索/阅读代码，不改文件
#   自定义 id     在 ~/.config/opencode/opencode.jsonc 的 agents 里自定义
#                例如 orchestrator：禁用内置工具、只用客户端声明的 tools，
#                实现"桥只部署一处、文件/命令在客户端执行"（见 docs/DESIGN.md §5.7.2）
BRIDGE_AGENT=build

# 工具执行模式（三选一，详见 README「工具执行模式」一节）：
#   A) OpenCode 原生执行：BRIDGE_AGENT=build + BRIDGE_TOOL_CALLING=false + BRIDGE_DIRECTORY=<项目>
#      —— 工具在 janus 主机、会话目录下执行，绕开 MCP 工具桥（本机自用推荐）。
#   B) 客户端执行(工具桥)：BRIDGE_AGENT=orchestrator + BRIDGE_TOOL_CALLING=true
#      —— agent 只用客户端声明的 tools，工具在客户端执行（opencode-openai-bridge 远程模式）。
#   C) 不用工具(纯问答)：BRIDGE_AGENT=orchestrator + BRIDGE_TOOL_CALLING=false
#      —— agent 手里没有任何工具，只会文本回答。

# 会话空闲多久后回收（同时会删掉上游 session）。支持 30m / 600s / 纯秒数
BRIDGE_SESSION_TTL=30m

# 单次补全的总超时
BRIDGE_REQUEST_TIMEOUT=600s

# 内存中最多保留多少个会话（LRU 淘汰）
BRIDGE_MAX_CONVERSATIONS=256


# ----------------------------------------------------------------------------
# 输出行为
# ----------------------------------------------------------------------------

# 是否把 agent 的工具活动以注释写进 content，例如：
#   <opencode-tool> bash: ls -la /path/to/project</opencode-tool>
# 开着能看见 agent 在干活；如果客户端自己做 agent 循环、不希望 content 被污染，
# 设成 false。注释在重放历史时会被自动剥掉，不会灌回上游。
BRIDGE_TOOL_ANNOTATIONS=true

# 事件流对账间隔（事件丢包时补内容）
BRIDGE_RECONCILE_INTERVAL=3s

# 空闲轮询间隔（判断一轮结束的兜底信号）
BRIDGE_IDLE_POLL_INTERVAL=1s

# prompt 之后多久才开始信任 idle 信号（防止误判"还没开始"为"已结束"）
BRIDGE_PROMPT_GRACE=2s

# SSE 心跳间隔。agent 跑工具时可能几分钟没有增量，靠它写 `: ping` 保活，
# 避免被中间代理/客户端读超时掐断。设成 0 或负数可关闭（不推荐）。
BRIDGE_STREAM_HEARTBEAT=15s


# ----------------------------------------------------------------------------
# 用量 / 余额（GET /v1/usage）
# ----------------------------------------------------------------------------

# 是否开放 /v1/usage。它需要读本地凭据库并访问 opencode.ai，不需要就关掉。
BRIDGE_USAGE_ENABLED=true

# 用量报告缓存时长（避免频繁打 console API）
BRIDGE_USAGE_TTL=30s

# OpenCode 的 SQLite 凭据库路径。留空 = 按 XDG 规则自动定位：
#   $XDG_DATA_HOME/opencode/opencode.db  →  否则 ~/.local/share/opencode/opencode.db
# OPENCODE_DB=

# OpenCode console API 基址，一般不用改
# OPENCODE_CONSOLE=https://opencode.ai/console/api

# OpenCode Go 套餐用量端点（5h 滚动 / 周 / 月限额）。与 console 不在同一个域。
# 非 Go 账号或接口不可用时自动忽略，不影响余额/用量。一般不用改。
# OPENCODE_GO_USAGE=https://opencode.ai/inference/go/v1/usage


# ----------------------------------------------------------------------------
# 工具调用 / Responses API
# ----------------------------------------------------------------------------

# 是否把客户端声明的 tools 暴露给 OpenCode agent（经内置 MCP server）。
# 关闭则客户端工具不暴露；配合 BRIDGE_AGENT=build 即「OpenCode 原生执行」模式。
BRIDGE_TOOL_CALLING=true

# 工具注册失败时的行为：
#   false（默认）= 直接报错，让客户端知道工具不可用
#   true         = 降级为"无工具"继续（模型会凭自己能力回答，可能不符合预期）
BRIDGE_TOOL_SOFT_FAIL=false

# 多久主动续注册一次 MCP（OpenCode 重启会丢掉所有注册，桥不知道）
BRIDGE_TOOL_REREGISTER=10m

# 工具调用挂起、等客户端回填结果的最长时间
BRIDGE_TOOL_CALL_WAIT=5m

# 注册给 OpenCode 的 MCP 基址。留空 = 用本机回环（同机部署即可）
# BRIDGE_MCP_URL=

# 限制内置 MCP 端点 /mcp/{token} 的来源（逗号分隔的 IP/CIDR）。
# 留空 = 不限制（OpenCode 与本桥同机时走回环，默认即可）。
# 对外暴露、或上游 OpenCode 在别的机器时，建议设为上游来源网段：
# BRIDGE_MCP_ALLOW=127.0.0.1/32,::1

# 自动应答 OpenCode 的权限请求（agent 访问会话目录之外的文件/目录时会先 ask）。
# headless 桥没有 UI 去点“允许”，不应答的话工具会一直挂到客户端超时。
#   once（默认）= 仅本次放行
#   always      = 放行并记住（会写入 OpenCode 的 saved permissions）
#   reject      = 拒绝（agent 会收到错误，但不会再挂住）
#   off         = 不自动应答（保持原行为，需要人工审批时用）
BRIDGE_PERMISSION_REPLY=once

# 是否开放 /v1/responses（Responses API）
BRIDGE_RESPONSES_ENABLED=true

# 已保存响应的保留时长（previous_response_id 依赖它）
BRIDGE_RESPONSE_TTL=30m

# 是否开放 Anthropic Messages API（/v1/messages，供 Claude Code / Anthropic SDK）
BRIDGE_ANTHROPIC_ENABLED=true

# 是否支持 Claude Code 的 web_search 服务端工具（由 Janus 内部调用上游 /api/websearch 执行）
# 同样适用于 OpenAI Responses API 的 {"type":"web_search"}
BRIDGE_WEBSEARCH_ENABLED=true

# 响应里 model 字段回显什么：
#   real    （默认）解析后的真实模型，如 opencode-go/mimo-v2.5-pro
#   request 客户端请求里的原始名，如 claude-sonnet-4-5
# BRIDGE_MODEL_ECHO=real


# ----------------------------------------------------------------------------
# 持久化（SQLite，github.com/qist/sqlite）
# ----------------------------------------------------------------------------

# 会话/响应库路径。开启后 Responses 的 previous_response_id、以及
# "会话键 → 上游 sessionID" 映射会落盘，跨进程重启仍能续上同一会话。
#   不设置 = 用默认路径：$XDG_DATA_HOME/janus/janus.db 或 ~/.local/share/janus/janus.db
#   设为 memory / off = 纯内存，不落盘（默认行为等价于内存 + 可选持久化）
# BRIDGE_DB=

# 落库的 Chat 历史快照上限（字节）。超过则只存会话映射、不存历史，避免库无界增长。
# 0 = 不限制。默认 1MiB。
# BRIDGE_HISTORY_MAX_BYTES=1048576

# 持久化的"会话键 → sessionID/历史"保留时长（janitor 清理）。默认 7 天。
# BRIDGE_CONV_TTL=168h


# ----------------------------------------------------------------------------
# 限流（防额度被刷爆 / 客户端重试风暴）
# ----------------------------------------------------------------------------

# 每个 API key（无 key 时按客户端 IP）每分钟允许的请求数。0 = 不限流。
# 建议公网部署时务必设置；本机调试可留 0。
BRIDGE_RATE_LIMIT=600

# 突发容量（桶大小）。0 = 同 BRIDGE_RATE_LIMIT。
# 允许短时间集中发几个请求，同时限制长期平均速率。
BRIDGE_RATE_BURST=120

# 全局每分钟上限（跨所有 key/IP）。0 = 不限。防止用一堆 key 绕过单 key 限流。
# BRIDGE_RATE_LIMIT_GLOBAL=

# 是否信任 X-Forwarded-For / X-Real-IP 来识别客户端 IP。
# 只有确实在可信反向代理后面才开 —— 否则客户端可以伪造头绕过限流。
BRIDGE_TRUST_PROXY=false


# ----------------------------------------------------------------------------
# 指标
# ----------------------------------------------------------------------------

# /metrics 是否免鉴权。false（默认）时 Prometheus 也要带 API key。
# 只在抓取端不方便带 key、且 /metrics 不暴露到公网时才设 true。
BRIDGE_METRICS_PUBLIC=false


# ----------------------------------------------------------------------------
# 日志
# ----------------------------------------------------------------------------

# debug / info / warn / error
# 排查问题时用 debug（会打印每次 prompt 的 session、delta 字节数、模型等）
BRIDGE_LOG_LEVEL=info
