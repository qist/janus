JANUS_ADDR=127.0.0.1:2810
JANUS_DB=./data/janus.db
JANUS_DB_KEY=
JANUS_DATA_DIR=./data
JANUS_LOG_LEVEL=info
JANUS_BOOTSTRAP_TOKEN=

# HTTP API：不设置则进程拒绝启动
JANUS_API_KEY=
JANUS_AGENT_ID=admin
# 可选：设置后 /verify 在该目录执行契约 checks
JANUS_WORKSPACE=
# 能力令牌签名密钥（>=32 字节）；不设置则从 JANUS_API_KEY 派生，重启后令牌失效
JANUS_CAPABILITY_KEY=
# 审计模型（JSON 数组）；不设置则敏感操作一律 deny
# JANUS_AUDITORS=[{"name":"openai","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","model":"gpt-4o-mini"}]
# /v1 代理暴露的模型（aliases 可选，api_key_envs 支持多 key 失败切换）
# JANUS_MODELS=[{"name":"openai","base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","aliases":["fast"],"api_key_envs":["OPENAI_KEY_1","OPENAI_KEY_2"]}]
