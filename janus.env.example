# ============================================================================
# opencode-openai-bridge 配置模板
#
# 用法：
#   1. 复制成 bridge.env
#        cp bridge.env.example bridge.env
#   2. 按需修改（最少只需要改 BRIDGE_API_KEY 和 BRIDGE_DIRECTORY）
#   3. 启动
#        ./run.sh            # 或 ./bridge
#
# 规则：
#   - 只写 KEY=VALUE，一行一个；# 开头是注释
#   - 值可以不加引号；要写空格或 # 时用双引号包起来
#   - **真实环境变量优先级更高**，可临时覆盖：
#        BRIDGE_LOG_LEVEL=debug ./bridge
#   - 换配置文件：BRIDGE_CONFIG=/path/to/other.env ./bridge
# ============================================================================


# ----------------------------------------------------------------------------
# 服务监听
# ----------------------------------------------------------------------------

# bridge 监听地址。
#   0.0.0.0:2810  局域网可访问（务必设 BRIDGE_API_KEY）
#   127.0.0.1:2810 仅本机
BRIDGE_ADDR=127.0.0.1:2810

# 客户端鉴权。客户端填这个值当 API Key。
# 留空 = 接受任意 Key 并打 WARN（仅限本机调试，不要这样裸奔到公网）
BRIDGE_API_KEY=sk-change-me

# 允许的浏览器来源（CORS）。
#   留空（默认）= 不发任何 CORS 头 = 拒绝跨源浏览器访问
#   *            = 允许任意来源（不带 credentials）
#   a,b          = 白名单，命中才放行（带 credentials）
# 桌面客户端（Trae/CodeBuddy）不受 CORS 约束，留空即可。
# BRIDGE_CORS_ORIGIN=


# ----------------------------------------------------------------------------
# 上游 OpenCode
# ----------------------------------------------------------------------------

# 上游地址。
#   auto                = 自动发现（推荐）。OpenCode 桌面端每次重启都换
#                         随机端口和随机密码，写死撑不过一次重启。
#   http://host:port    = 固定地址（远程实例用这个，此时必须同时设密码）
OPENCODE_URL=auto

# 上游 Basic 认证用户名，OpenCode 固定是 opencode，一般不用改
OPENCODE_USERNAME=opencode

# 上游密码。auto 模式下会自动从进程环境读取，留空即可。
# 只有 OPENCODE_URL 写死时才需要手填。
# OPENCODE_PASSWORD=


# ----------------------------------------------------------------------------
# 会话
# ----------------------------------------------------------------------------

# 会话默认工作目录（OpenCode 的项目路径）。
# 建议设成你实际要 Trae/CodeBuddy 操作的代码目录。
BRIDGE_DIRECTORY=/opt/iptv

# default / auto / 空模型别名实际使用的模型。
# 订阅 OpenCode Go 套餐时，建议指定 opencode-go 模型：
BRIDGE_DEFAULT_MODEL=opencode-go/gpt-6-luna

# 默认 agent。build 是可读写代码的完整 agent。
# 可选：build / plan（只读，先规划再动手）/ general / explore
# 另有自定义 orchestrator（见 DESIGN 5.7.2）：禁用内置工具、只用客户端声明的
# tools。要让"桥只部署一处、文件/命令在客户端执行"，把它设成 orchestrator
# （需先在 ~/.config/opencode/opencode.jsonc 里定义该 agent）。
BRIDGE_AGENT=build

# 会话空闲多久后回收（同时会删掉上游 session）。支持 30m / 600s / 纯秒数
BRIDGE_SESSION_TTL=30m

# 单次补全的总超时
BRIDGE_REQUEST_TIMEOUT=600s

# 内存中最多保留多少个会话（LRU 淘汰）
BRIDGE_MAX_CONVERSATIONS=256


# ----------------------------------------------------------------------------
# 输出行为
# ----------------------------------------------------------------------------

# 是否把 agent 的工具活动以注释写进 content，例如：
#   <opencode-tool> bash: ls -la /opt/iptv</opencode-tool>
# 开着能看见 agent 在干活；如果客户端自己做 agent 循环、不希望 content 被污染，
# 设成 false。注释在重放历史时会被自动剥掉，不会灌回上游。
BRIDGE_TOOL_ANNOTATIONS=true

# 事件流对账间隔（事件丢包时补内容）
BRIDGE_RECONCILE_INTERVAL=3s

# 空闲轮询间隔（判断一轮结束的兜底信号）
BRIDGE_IDLE_POLL_INTERVAL=1s

# prompt 之后多久才开始信任 idle 信号（防止误判"还没开始"为"已结束"）
BRIDGE_PROMPT_GRACE=2s

# SSE 心跳间隔。agent 跑工具时可能几分钟没有增量，靠它写 `: ping` 保活，
# 避免被中间代理/客户端读超时掐断。设成 0 或负数可关闭（不推荐）。
BRIDGE_STREAM_HEARTBEAT=15s


# ----------------------------------------------------------------------------
# 用量 / 余额（GET /v1/usage）
# ----------------------------------------------------------------------------

# 是否开放 /v1/usage。它需要读本地凭据库并访问 opencode.ai，不需要就关掉。
BRIDGE_USAGE_ENABLED=true

# 用量报告缓存时长（避免频繁打 console API）
BRIDGE_USAGE_TTL=30s

# OpenCode 的 SQLite 凭据库路径。留空 = 按 XDG 规则自动定位
# （~/.local/share/opencode/opencode.db）
# OPENCODE_DB=

# OpenCode console API 基址，一般不用改
# OPENCODE_CONSOLE=https://opencode.ai/console/api


# ----------------------------------------------------------------------------
# 工具调用 / Responses API
# ----------------------------------------------------------------------------

# 是否把客户端声明的 tools 暴露给 OpenCode agent（经内置 MCP server）
BRIDGE_TOOL_CALLING=true

# 工具注册失败时的行为：
#   false（默认）= 直接报错，让客户端知道工具不可用
#   true         = 降级为"无工具"继续（模型会凭自己能力回答，可能不符合预期）
BRIDGE_TOOL_SOFT_FAIL=false

# 多久主动续注册一次 MCP（OpenCode 重启会丢掉所有注册，桥不知道）
BRIDGE_TOOL_REREGISTER=10m

# 工具调用挂起、等客户端回填结果的最长时间
BRIDGE_TOOL_CALL_WAIT=5m

# 注册给 OpenCode 的 MCP 基址。留空 = 用本机回环（同机部署即可）
# BRIDGE_MCP_URL=

# 自动应答 OpenCode 的权限请求（agent 访问会话目录之外的文件/目录时会先 ask）。
# headless 桥没有 UI 去点“允许”，不应答的话工具会一直挂到客户端超时。
#   once（默认）= 仅本次放行
#   always      = 放行并记住（会写入 OpenCode 的 saved permissions）
#   reject      = 拒绝（agent 会收到错误，但不会再挂住）
#   off         = 不自动应答（保持原行为，需要人工审批时用）
BRIDGE_PERMISSION_REPLY=once

# 是否开放 /v1/responses（Responses API）
BRIDGE_RESPONSES_ENABLED=true

# 已保存响应的保留时长（previous_response_id 依赖它）
BRIDGE_RESPONSE_TTL=30m


# ----------------------------------------------------------------------------
# 限流（防额度被刷爆 / 客户端重试风暴）
# ----------------------------------------------------------------------------

# 每个 API key（无 key 时按客户端 IP）每分钟允许的请求数。0 = 不限流。
# 建议公网部署时务必设置；本机调试可留 0。
BRIDGE_RATE_LIMIT=600

# 突发容量（桶大小）。0 = 同 BRIDGE_RATE_LIMIT。
# 允许短时间集中发几个请求，同时限制长期平均速率。
BRIDGE_RATE_BURST=120

# 全局每分钟上限（跨所有 key/IP）。0 = 不限。防止用一堆 key 绕过单 key 限流。
# BRIDGE_RATE_LIMIT_GLOBAL=

# 是否信任 X-Forwarded-For / X-Real-IP 来识别客户端 IP。
# 只有确实在可信反向代理后面才开 —— 否则客户端可以伪造头绕过限流。
BRIDGE_TRUST_PROXY=false


# ----------------------------------------------------------------------------
# 指标
# ----------------------------------------------------------------------------

# /metrics 是否免鉴权。false（默认）时 Prometheus 也要带 API key。
# 只在抓取端不方便带 key、且 /metrics 不暴露到公网时才设 true。
BRIDGE_METRICS_PUBLIC=false


# ----------------------------------------------------------------------------
# 日志
# ----------------------------------------------------------------------------

# debug / info / warn / error
# 排查问题时用 debug（会打印每次 prompt 的 session、delta 字节数、模型等）
BRIDGE_LOG_LEVEL=info
